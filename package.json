{
  "name": "epi-erp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "Backend",
    "Frontend"
  ],
  "scripts": {
    "dev:web": "npm run start -w @epi/frontend",
    "dev:api": "npm run dev -w @epi/backend",
    "build": "npm run build -w @epi/frontend && npm run build -w @epi/backend",
    "test": "npm run test -w @epi/backend && npm run test:demo && npm run test:db",
    "test:demo": "node --import tsx --test Frontend/test/*.test.ts",
    "test:db": "node --import tsx --test database/tests/*.test.ts",
    "test:browser": "playwright test --config Frontend/playwright.config.ts",
    "db:setup": "node database/scripts/build-setup.mjs",
    "db:check": "node database/scripts/build-setup.mjs --check",
    "api:docs": "node --import tsx Backend/scripts/write-openapi.ts",
    "ca:import": "node --env-file-if-exists=.env --env-file-if-exists=Backend/.env --import tsx Backend/scripts/import-ca.ts",
    "documents:preview": "node --import tsx Backend/scripts/preview-document.ts",
    "typecheck": "npm run typecheck -w @epi/backend && npm run typecheck -w @epi/frontend"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "1.56.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6"
  }
}
