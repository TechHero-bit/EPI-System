{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": { "api/index.ts": { "maxDuration": 30 } },
  "crons": [{ "path": "/api/jobs/retention", "schedule": "0 3 * * *" }]
}
