{
  "name": "@epi/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "cors": "2.8.5",
    "express": "5.3.0",
    "helmet": "8.1.0",
    "nodemailer": "7.0.6",
    "pdf-lib": "1.17.1",
    "exceljs": "4.4.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/nodemailer": "7.0.1",
    "@types/node": "24.10.1",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "6.0.2"
  }
}
