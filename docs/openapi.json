{
  "openapi": "3.1.0",
  "info": {
    "title": "EPI System API",
    "version": "0.2.0",
    "description": "Autenticação via Supabase Auth. Perfis por organização. Estoque físico só baixa na entrega."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "security": [
    {
      "Bearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "SheetItem": {
        "type": "object",
        "required": [
          "variantId",
          "lotId"
        ],
        "properties": {
          "variantId": {
            "type": "string",
            "format": "uuid"
          },
          "lotId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "const": 1
          },
          "risk": {
            "type": "string",
            "maxLength": 30
          }
        }
      },
      "IssueSheet": {
        "type": "object",
        "required": [
          "employeeId",
          "documentDate",
          "method",
          "idempotencyKey",
          "items"
        ],
        "properties": {
          "employeeId": {
            "type": "string",
            "format": "uuid"
          },
          "documentDate": {
            "type": "string",
            "format": "date"
          },
          "method": {
            "enum": [
              "MANUAL",
              "ELECTRONIC"
            ]
          },
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 15,
            "items": {
              "$ref": "#/components/schemas/SheetItem"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Saúde pública da API",
