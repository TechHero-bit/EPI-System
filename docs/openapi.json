            "description": "Operação concluída"
          },
          "201": {
            "description": "Registro criado"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Sessão ou código inválido"
          },
          "403": {
            "description": "Perfil não autorizado"
          },
          "409": {
            "description": "Conflito de estado ou saldo"
          },
          "410": {
            "description": "Link expirado ou consumido"
          },
          "429": {
            "description": "Limite de tentativas"
          },
          "503": {
            "description": "Integração indisponível"
