    "@angular/router": "^22.2.3",
    "@supabase/supabase-js": "2.118.0",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "1.5.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@tailwindcss/postcss": "4.1.17",
    "@types/qrcode": "1.5.6",
